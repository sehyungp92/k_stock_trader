# =============================================
# KIS API Credentials
# =============================================
# Korea Investment & Securities API credentials
# Get these from: https://openapi.koreainvestment.com

KIS_APP_KEY=your_app_key
KIS_APP_SECRET=your_app_secret
KIS_ACCOUNT_NO=12345678
KIS_ACCOUNT_PROD_CODE=01
KIS_IS_PAPER=true

# HTS User ID (required for condition search and WebSocket subscriptions)
KIS_HTS_ID=your_hts_id

# User-Agent string sent with KIS API requests
KIS_MY_AGENT=Mozilla/5.0

# =============================================
# Paper Trading Credentials (Optional)
# =============================================
# If using separate credentials for paper trading
# Leave empty to use the same credentials above

KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=

# =============================================
# PostgreSQL Database
# =============================================
# Passwords for PostgreSQL roles

# Admin password (postgres user)
POSTGRES_PASSWORD=your_secure_password

# OMS writer role password
POSTGRES_WRITER_PASSWORD=writer_password

# Read-only role password (for dashboards and tooling)
POSTGRES_READER_PASSWORD=reader_password
POSTGRES_HOST_PORT=5432

# OMS instance ID (for multi-OMS shared Postgres; default: primary)
# OMS_ID=primary

# =============================================
# PCIM External APIs
# =============================================
# Required for PCIM strategy

# Google Gemini API key (for transcript analysis)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# =============================================
# OLR/KALCB Runtime
# =============================================
# Default approved deployment universe. Override only with a reviewed manifest.
OLR_KALCB_DAILY_UNIVERSE_FILE=config/olr_kalcb/olr_deployment_universe_103.yaml

# Set these for long-running dry-run, paper, or live runtime service sessions.
OLR_KALCB_RUNTIME_MODE=dry_run
OLR_KALCB_BASELINE_MANIFEST=/app/data/live_readiness/olr_kalcb/2026-05-28/baseline_manifest.json
OLR_KALCB_TRADE_DATE=
OLR_KALCB_BARS_PARQUET=
OLR_KALCB_HEALTH_CHECKS_JSON=
OLR_KALCB_ACCOUNT_STATE_JSON=
OLR_KALCB_POSITIONS_JSON=
OLR_KALCB_START_RUNTIME_AFTER_PREMARKET=false
OLR_KALCB_RESTART_RUNTIME_AFTER_AFTERNOON=false

# =============================================
# Instrumentation Sidecar
# =============================================
# Relay endpoint for forwarding instrumentation events
# Set to the actual relay URL (e.g. https://relay.yourvps.com/events)
SIDECAR_RELAY_URL=

# HMAC secret for signing events forwarded by sidecar to central relay
# Must match the secret configured on the relay server
INSTRUMENTATION_HMAC_SECRET=
